# Template for the secrets file. Copy this file to .env and fill in your own values.
# .env is ignored by git; this template is committed so teammates know which keys exist.

# Required: USDA FoodData Central (https://fdc.nal.usda.gov/api-guide.html)
USDA_API_KEY=

# Optional: Hugging Face token for faster downloads (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Optional: only if the Kaggle download asks for credentials (kaggle.com -> Settings -> API)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional: TheMealDB supporter key (the notebook uses the free test key if empty)
THEMEALDB_API_KEY=

# Optional: RecipeDB key from the CoSyLab team (not used by the code yet)
RECIPEDB_API_KEY=

# Later: Sourcing Agent
GOOGLE_PLACES_API_KEY=

# Later: Chef Agent LLM (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: local models through Ollama (VS Code / Antigravity, no key needed).
# Only set this when Ollama is not at http://localhost:11434. See docs/ollama_plan.md
# OLLAMA_HOST=
