# Secrets - never commit these
.env
.env.*
!.env.example
kaggle.json

# Generated data - recreated by the notebook; the large CSVs
# are over GitHub's 100 MB file limit. Keep the empty folders.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Python / Jupyter clutter
__pycache__/
.ipynb_checkpoints/
.venv/
venv/

# Fitted models - recreated by the notebook (section 6.6)
models/

# Personal editor and assistant settings - each person keeps their own
.vscode/
.claude/settings.local.json

# Test coverage reports (pytest --cov)
.coverage
.coverage.*
coverage.xml
htmlcov/

# User data and logs - never commit (allergies, religious diets and health conditions are personal data;
# see docs/ethics_privacy.md "User data"). Keep them under data/user/ or logs/ on the machine that runs the app.
data/user/
logs/
*.audit.jsonl
audit*.jsonl
user_profiles*
chat_history*
